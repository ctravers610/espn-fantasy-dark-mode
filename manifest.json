{
  "manifest_version": 3,
  "name": "Fantasy Dark Modes",
  "version": "1.1.0",
  "description": "Dark themes for ESPN Fantasy and Yahoo Fantasy Football. Click the toolbar icon to turn them on or off.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Fantasy Dark Modes",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.espn.net/*", "https://*.espncdn.com/*", "https://*.yimg.com/*"],
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/*", "https://football.fantasysports.yahoo.com/*"],
      "js": ["colors.js", "content.js"],
      "css": ["early.css"],
      "run_at": "document_start"
    }
  ]
}
