{
  "manifest_version": 3,
  "name": "ESPN Fantasy Dark Mode",
  "version": "1.0.0",
  "description": "A dark theme for ESPN Fantasy. Click the toolbar icon to turn it on or off.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ESPN Fantasy Dark Mode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.espn.net/*", "https://*.espncdn.com/*"],
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/*"],
      "js": ["colors.js", "content.js"],
      "css": ["early.css"],
      "run_at": "document_start"
    }
  ]
}
